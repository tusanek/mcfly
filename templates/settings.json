{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(mcfly finding add *)",
      "Bash(mcfly ideas add *)",
      "Bash(mcfly metric add *)",
      "Bash(mcfly question add *)",
      "Bash(mcfly samples shoot *)",
      "Bash(mcfly worktree link)",
      "Bash(mcfly worktree link --project *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(launchctl *)",
      "Bash(mcfly action *)",
      "Read(./mcfly/.env)",
      "Edit(./mcfly/config.yaml)",
      "Edit(./mcfly/.env)",
      "Read(./.env)",
      "Edit(./.env)"
    ]
  }
}
